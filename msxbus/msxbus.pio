;
; MSX Cartridge Bus Pure PIO Engine for Waveshare RP2350-PiZero
;
; Fully hardware-timed MSX Bus Engine:
;   - Address Latch with 2-bit Side-Set on GPIO 8 (MODE0) and GPIO 9 (MODE1)
;     01 (MODE1=0, MODE0=1) : Low Address  (A0-A7)
;     11 (MODE1=1, MODE0=1) : High Address (A8-A15)
;     10 (MODE1=1, MODE0=0) : Data         (D0-D7)
;     00 (MODE1=0, MODE0=0) : Idle
;   - Simultaneous Control assertion (/RD, /WR, /MREQ, /IORQ, /SLTSL1, /SLTSL2) on GPIO 10-15
;   - Hardware /WAIT (GPIO 16) synchronization
;   - Atomic data sampling and bus restore
;

.define public SIDE_LOW_ADDR   0b01  ; MODE1=0, MODE0=1 (Low Address A0-A7)
.define public SIDE_HIGH_ADDR  0b11  ; MODE1=1, MODE0=1 (High Address A8-A15)
.define public SIDE_DATA       0b10  ; MODE1=1, MODE0=0 (Data D0-D7)
.define public SIDE_IDLE       0b00  ; MODE1=0, MODE0=0 (Idle state)

; ------------------------------------------------------------------------------
; 1. Pure PIO Read Engine: Address -> Control (/SLTSL,/RD,/MREQ) -> /WAIT -> Data Read
; ------------------------------------------------------------------------------
.program msxbus_read
.side_set 2

.wrap_target
    pull block                  side SIDE_IDLE
    ; OSR: [7:0]=Low Addr, [15:8]=High Addr, [31:16]=Control mask for GPIO 0-15

    ; 1. Output Low Address (A0-A7) with MODE = 01 (Low Addr)
    out pins, 8                 side SIDE_LOW_ADDR [4]

    ; 2. Output High Address (A8-A15) with MODE = 11 (High Addr)
    out pins, 8                 side SIDE_HIGH_ADDR [4]

    ; 3. Simultaneously assert /SLTSL, /RD, /MREQ on GPIO 10-15 and switch MODE to 10 (Data)
    out pins, 16                side SIDE_DATA

    ; 4. Float data bus (GPIO 0-7 -> INPUT)
    mov osr, null               side SIDE_DATA
    out pindirs, 8              side SIDE_DATA

    ; 5. Hardware wait until /WAIT (GPIO 16) is HIGH (1 = ready)
    wait 1 gpio 16              side SIDE_DATA

    ; 6. ROM data settle delay (~300ns)
    nop [7]                     side SIDE_DATA
    nop [7]                     side SIDE_DATA

    ; 7. Sample 8-bit data from GPIO 0-7 into ISR and push to RX FIFO
    in pins, 8                  side SIDE_DATA
    push block                  side SIDE_DATA

    ; 8. Deassert all control lines (GPIO 10-15 -> 1) and restore GPIO 0-7 to OUTPUT
    mov osr, ~null              side SIDE_IDLE
    out pins, 16                side SIDE_IDLE
    mov osr, ~null              side SIDE_IDLE
    out pindirs, 8              side SIDE_IDLE [2]
.wrap

; ------------------------------------------------------------------------------
; 2. Pure PIO Write Engine: Address -> Control (/SLTSL,/WR,/MREQ) -> Data Out -> /WAIT
; ------------------------------------------------------------------------------
.program msxbus_write
.side_set 2

.wrap_target
    pull block                  side SIDE_IDLE
    ; Word 1: [7:0]=Low Addr, [15:8]=High Addr, [31:16]=Control mask for GPIO 0-15

    ; 1. Output Low Address (A0-A7) with MODE = 01 (Low Addr)
    out pins, 8                 side SIDE_LOW_ADDR [4]

    ; 2. Output High Address (A8-A15) with MODE = 11 (High Addr)
    out pins, 8                 side SIDE_HIGH_ADDR [4]

    ; 3. Simultaneously assert /SLTSL, /WR, /MREQ on GPIO 10-15 and switch MODE to 10 (Data)
    out pins, 16                side SIDE_DATA

    ; 4. Pull Word 2 (Data byte D0-D7) and output to GPIO 0-7
    pull block                  side SIDE_DATA
    out pins, 8                 side SIDE_DATA [4]

    ; 5. Hardware wait until /WAIT (GPIO 16) is HIGH (1 = ready)
    wait 1 gpio 16              side SIDE_DATA

    ; 6. Data hold delay
    nop [7]                     side SIDE_DATA
    nop [7]                     side SIDE_DATA

    ; 7. Deassert all control lines (GPIO 10-15 -> 1) and restore MODE to IDLE (11)
    mov osr, ~null              side SIDE_IDLE
    out pins, 16                side SIDE_IDLE [2]
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/pio.h"

static inline void msxbus_pio_read_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = msxbus_read_program_get_default_config(offset);

    // OUT pins: GPIO 0-15 (0-7: Data/Addr, 8-9: Side-set, 10-15: Controls)
    sm_config_set_out_pins(&c, 0, 16);
    // IN pins: GPIO 0-7 (Data read)
    sm_config_set_in_pins(&c, 0);
    // SIDESET pins: GPIO 8 (MODE0), GPIO 9 (MODE1)
    sm_config_set_sideset_pins(&c, 8);

    for (uint i = 0; i <= 15; i++) {
        pio_gpio_init(pio, i);
    }

    pio_sm_set_consecutive_pindirs(pio, sm, 0, 16, true);

    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_in_shift(&c, true, false, 8);

    float div = (float)clock_get_hz(clk_sys) / 50000000.0f; // ~50 MHz
    if (div < 1.0f) div = 1.0f;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void msxbus_pio_write_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = msxbus_write_program_get_default_config(offset);

    sm_config_set_out_pins(&c, 0, 16);
    sm_config_set_sideset_pins(&c, 8);

    for (uint i = 0; i <= 15; i++) {
        pio_gpio_init(pio, i);
    }

    pio_sm_set_consecutive_pindirs(pio, sm, 0, 16, true);

    sm_config_set_out_shift(&c, true, false, 32);

    float div = (float)clock_get_hz(clk_sys) / 50000000.0f; // ~50 MHz
    if (div < 1.0f) div = 1.0f;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
