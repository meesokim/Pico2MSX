;
; MSX Cartridge Bus — single PIO SM, separate read/write entry points
;
; Fits in remaining PIO2 slots next to PSRAM SPI (~10 instr). Length = 22.
;
; Side-set GPIO8=MODE0, GPIO9=MODE1 into a 2-to-4 selector. The selector
; steers GPIO 0-7 and the 74HC373 LE of each latch:
;   00  Idle
;   01  Low address  (A0-A7)   — 373_low transparent
;   11  High address (A8-A15)  — leaving 01 latches A0-A7; 373_high transparent
;   10  Data         (D0-D7)   — leaving 11 latches A8-A15
;
; Put A_high only AFTER selecting 11. Do not float GPIO 0-7 while still on 11
; (high 373 would follow a floating D). Switch 11→10 first, then Hi-Z.
;
; TX word (shift-right, LSB first):
;   [7:0]   A0-A7
;   [15:8]  A8-A15
;   [31:16] GPIO 0-15 OUT image (data in [7:0], control in [15:10])
;
; CPU: wait until PC is at `common` (pull), exec jmp to entry_read/entry_write, then put.
; Wrap returns to entry_read (set X=0, pull). Do not use pio_sm_is_exec_stalled —
; that flag only tracks instructions written via SM_INSTR, not a program pull.
;

.define public SIDE_IDLE       0b00
.define public SIDE_LOW_ADDR   0b01
.define public SIDE_DATA       0b10
.define public SIDE_HIGH_ADDR  0b11

.program msxbus
.side_set 2

.wrap_target
public entry_read:
    set x, 0                    side SIDE_IDLE
    jmp common                  side SIDE_IDLE
public entry_write:
    set x, 1                    side SIDE_IDLE
public common:
    pull block                  side SIDE_IDLE
    out pins, 8                 side SIDE_IDLE [1]
    nop                         side SIDE_LOW_ADDR [3]
    out pins, 8                 side SIDE_HIGH_ADDR [1]
    nop                         side SIDE_HIGH_ADDR [3]
    mov y, osr                  side SIDE_HIGH_ADDR
    jmp !x, do_read             side SIDE_HIGH_ADDR
    out pins, 16                side SIDE_DATA [7]
    nop                         side SIDE_DATA [7]
    jmp restore                 side SIDE_IDLE
do_read:
    ; 11→10 latches A8-A15, then CPU Hi-Z, then /RD held for SIO sample.
    push block                  side SIDE_DATA
    pull block                  side SIDE_DATA
    mov osr, y                  side SIDE_DATA
    out pins, 16                side SIDE_DATA [7]
    push block                  side SIDE_DATA
    pull block                  side SIDE_DATA
restore:
    mov osr, ~null              side SIDE_IDLE
    out pins, 16                side SIDE_IDLE
    out pindirs, 8              side SIDE_IDLE [2]
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/pio.h"
#include "hardware/gpio.h"

static inline void msxbus_pio_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = msxbus_program_get_default_config(offset);

    sm_config_set_out_pins(&c, 0, 16);
    sm_config_set_in_pins(&c, 0);
    sm_config_set_sideset_pins(&c, 8);

    for (uint i = 0; i <= 15; i++) {
        pio_gpio_init(pio, i);
        gpio_set_pulls(i, false, false);
    }

    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_in_shift(&c, false, true, 8);
    sm_config_set_in_pin_count(&c, 8);

    /* ~20 MHz: 8-cycle [7] delay ≈ 400 ns ROM tACC after /RD. */
    float div = (float)clock_get_hz(clk_sys) / 20000000.0f;
    if (div < 1.0f) div = 1.0f;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_consecutive_pindirs(pio, sm, 0, 16, true);
    pio_sm_set_pins_with_mask(pio, sm, 0xFC00u, 0xFFFFu);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void msxbus_pio_wait_pull(PIO pio, uint sm, uint offset) {
    const uint pull_pc = offset + msxbus_offset_common;
    while (pio_sm_get_pc(pio, sm) != pull_pc) {
        tight_loop_contents();
    }
}

static inline void msxbus_pio_exec_entry(PIO pio, uint sm, uint offset, uint entry) {
    msxbus_pio_wait_pull(pio, sm, offset);
    pio_sm_exec(pio, sm, pio_encode_jmp(offset + entry));
}
%}
